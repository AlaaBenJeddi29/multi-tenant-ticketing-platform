PORT=5000

DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

JWT_SECRET=your-secret-key-here-change-in-production

NODE_ENV=development

CLIENT_URL=http://localhost:5173

# SMTP Configuration (Optional - leave blank to use console logging for emails)
# Example configurations for common providers:
#
# Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com
#
# Outlook:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
#
# AWS SES SMTP:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
#
# Brevo (formerly Sendinblue):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Super Admin Seed Configuration
SUPER_ADMIN_EMAIL=admin@yourplatform.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=Admin
